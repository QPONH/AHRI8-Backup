<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标框架改成 .NET Framework 4.8：Windows 10 1903+ / Windows 11 自带，
         发布出去的单文件 exe 不需要再安装 .NET 运行时，也不会像自包含 .NET 8
         那样首次启动要先解压到 %TEMP%（受限环境下会直接无窗口退出）。 -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AHRI8Backup</AssemblyName>
    <RootNamespace>AHRI8Backup</RootNamespace>

    <!-- 应用图标：多尺寸 .ico 已嵌入 exe（资源管理器 / 任务栏 / 文件属性都能看到）。 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <AssemblyTitle>AHRI8 收藏备份工具</AssemblyTitle>
    <Product>AHRI8Backup</Product>
    <Description>把漫画镜像站收藏夹里的作品批量备份到本地（单文件、无需安装运行时）</Description>
    <Company>AHRI8Backup</Company>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>

    <!-- 不生成 AHRI8Backup.exe.config；单文件发布包里只留一个 exe。 -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- HtmlAgilityPack 随源码放在 libs\ 里：构建不需要联网还原，运行时也从 exe 内的嵌入资源加载。
         Private=false 确保它不会被复制到输出目录，发布物仍然只有一个 exe。 -->
    <Reference Include="HtmlAgilityPack">
      <HintPath>libs\HtmlAgilityPack.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- .NET Framework 自带的程序集：HttpUtility 与 JavaScriptSerializer。 -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <!-- ProtectedData / DataProtectionScope（密码用 DPAPI 加密保存）。 -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="libs\HtmlAgilityPack.dll" LogicalName="AHRI8Backup.Embedded.HtmlAgilityPack.dll" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="AHRI8Backup.Assets.app.ico" />
  </ItemGroup>
</Project>
